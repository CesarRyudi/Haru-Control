# Etapa de Build
FROM node:18.20-alpine AS builder

WORKDIR /app

# Copia os arquivos de configuração de dependências
COPY package*.json ./

# Instala todas as dependências limitando conexões simultâneas (evita picos excessivos de rede/RAM)
RUN npm ci --maxsockets 1

# Copia todo o código fonte
COPY . .

# Gera o client do Prisma
RUN cd apps/api && npx prisma generate

# Executa o build da API via Nx
RUN npx nx build api --prod

# Limpa dependências de desenvolvimento, mantendo apenas as de produção e o Prisma CLI
RUN npm prune --omit=dev && npm install prisma --no-save --maxsockets 1

# Etapa de Produção (usando 18.20-alpine para evitar o bug de substituição de string do Coolify)
FROM node:18.20-alpine AS production

WORKDIR /app

ENV PORT=3000
ENV NODE_ENV=production

# Copia o node_modules limpo e o package.json do builder (ZERO concorrência de npm install em paralelo)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./

# Copia o build gerado na etapa anterior
COPY --from=builder /app/dist/apps/api ./dist/apps/api

# Copia os arquivos do Prisma (schema e migrations)
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

EXPOSE 3000

# Executa as migrations e inicia o servidor
CMD npx prisma migrate deploy --schema=./apps/api/prisma/schema.prisma && node dist/apps/api/main.js
