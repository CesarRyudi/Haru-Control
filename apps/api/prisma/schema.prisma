generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Product {
    id            String   @id @default(uuid())
    name          String
    unit          String   @default("Un")
    price         Decimal  @db.Decimal(10, 2)
    categoryId    String?  @map("category_id")
    isSellable    Boolean  @default(false) @map("is_sellable")
    isPurchasable Boolean  @default(false) @map("is_purchasable")
    createdAt     DateTime @default(now()) @map("created_at")
    updatedAt     DateTime @updatedAt @map("updated_at")

    category      Category?     @relation(fields: [categoryId], references: [id])
    orderItems    OrderItem[]
    ledgerEntries LedgerEntry[]
    recipeItems   RecipeItem[]  @relation("ParentProduct")
    usedIn        RecipeItem[]  @relation("ChildProduct")

    @@map("products")
}

model Category {
    id          String   @id @default(uuid())
    name        String
    price       Decimal? @db.Decimal(10, 2)
    observation String?
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    products Product[]

    @@map("categories")
}

model Customer {
    id          String   @id @default(uuid())
    name        String
    phone       String?
    address     String?
    observation String?
    createdAt   DateTime @default(now()) @map("created_at")

    orders Order[]

    @@map("customers")
}

model Order {
    id          String      @id @default(uuid())
    customerId  String?     @map("customer_id")
    status      OrderStatus @default(DRAFT)
    totalPrice  Decimal     @map("total_price") @db.Decimal(10, 2)
    deliveryFee Decimal     @default(2.00) @map("delivery_fee") @db.Decimal(10, 2)
    address     String?
    createdAt   DateTime    @default(now()) @map("created_at")
    updatedAt   DateTime    @updatedAt @map("updated_at")

    customer      Customer?     @relation(fields: [customerId], references: [id])
    items         OrderItem[]
    ledgerEntries LedgerEntry[]
    sale          Sale?

    @@map("orders")
}

enum OrderStatus {
    DRAFT
    PENDING
    READY
    COMPLETED
    CANCELLED
}

model OrderItem {
    id        String  @id @default(uuid())
    orderId   String  @map("order_id")
    productId String  @map("product_id")
    quantity  Decimal @db.Decimal(10, 4)
    unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

    order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
    product Product @relation(fields: [productId], references: [id])

    @@map("order_items")
}

model Sale {
    id        String   @id @default(uuid())
    orderId   String   @unique @map("order_id")
    createdAt DateTime @default(now()) @map("created_at")

    order Order @relation(fields: [orderId], references: [id])

    @@map("sales")
}

model LedgerEntry {
    id        String              @id @default(uuid())
    productId String              @map("product_id")
    quantity  Decimal             @db.Decimal(10, 4)
    type      LedgerOperationType
    orderId   String?             @map("order_id")
    createdAt DateTime            @default(now()) @map("created_at")

    product Product @relation(fields: [productId], references: [id])
    order   Order?  @relation(fields: [orderId], references: [id])

    @@map("ledger_entries")
}

enum LedgerOperationType {
    STOCK_IN
    STOCK_ADJUSTMENT
    RESERVE
    RELEASE
    SALE
    CORRECTION
    MANUFACTURING_CONSUMPTION
    MANUFACTURING_PRODUCTION
}

model RecipeItem {
    id       String  @id @default(uuid())
    parentId String  @map("parent_id")
    childId  String  @map("child_id")
    quantity Decimal @db.Decimal(10, 4)
    unit     String  @default("Un")

    parent Product @relation("ParentProduct", fields: [parentId], references: [id], onDelete: Cascade)
    child  Product @relation("ChildProduct", fields: [childId], references: [id], onDelete: Restrict)

    @@unique([parentId, childId])
    @@map("recipe_items")
}
